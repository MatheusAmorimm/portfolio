# Copie para .env.local e preencha. NUNCA commite .env.local.
#
# Nada aqui é obrigatório para o site subir: sem estas variáveis a build
# passa e todas as páginas funcionam. O que muda é o formulário de
# contato e a URL absoluta usada em canonical, hreflang e sitemap.

# ---------------------------------------------------------------------
# Formulário de contato — provedor Resend (https://resend.com)
# ---------------------------------------------------------------------

# Sem RESEND_API_KEY o formulário responde "envio indisponível" e manda o
# visitante para o e-mail e as redes, que ficam logo acima na página.
# RESEND_API_KEY=

# Para onde a mensagem vai. Sem isto, cai no e-mail público do autor.
# CONTACT_TO_EMAIL=

# Remetente. Enquanto não houver domínio próprio verificado na Resend,
# só `onboarding@resend.dev` é aceito — e ele só entrega para o e-mail
# dono da conta, que é exatamente o caso aqui.
# CONTACT_FROM_EMAIL=onboarding@resend.dev

# ---------------------------------------------------------------------
# Endereço público do site
# ---------------------------------------------------------------------

# URL canônica, usada em canonical, hreflang, sitemap.xml e og:image.
# Na Vercel, deixe em branco: o próprio deploy injeta
# VERCEL_PROJECT_PRODUCTION_URL e o site usa esse endereço sozinho.
# Preencha só quando existir domínio próprio, com https e sem barra final.
# NEXT_PUBLIC_SITE_URL=https://seudominio.com

# ---------------------------------------------------------------------
# Buscadores
# ---------------------------------------------------------------------

# A produção é indexável por padrão, e previews de deploy nunca são.
# Defina como "true" para tirar o site inteiro dos buscadores sem
# precisar de um novo deploy — é a saída de emergência.
# BLOCK_INDEXING=true
